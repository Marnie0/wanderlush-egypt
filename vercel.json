{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Link",
          "value": "</images/hero/egypt-hero-1600.webp>; rel=preload; as=image; imagesrcset=\"/images/hero/egypt-hero-640.webp 640w, /images/hero/egypt-hero-1024.webp 1024w, /images/hero/egypt-hero-1600.webp 1600w, /images/hero/egypt-hero-2400.webp 2400w\"; imagesizes=\"100vw\""
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
